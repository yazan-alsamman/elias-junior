# Copy this file to `.env` (same folder) and fill in your real token.
# The CV parser auto-loads `.env` at startup, so you only set this once.

# 1. Get a Read token: https://huggingface.co/settings/tokens
# 2. Request access:   https://huggingface.co/meta-llama/Llama-3.2-3B-Instruct
HF_TOKEN=hf_replace_me

# Optional overrides:
CV_API_MODEL_ID=meta-llama/Llama-3.2-3B-Instruct
CV_API_ADAPTER_PATH=lora-resume-archive
CV_API_LOAD_IN_4BIT=1
