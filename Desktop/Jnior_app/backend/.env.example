# API (Express) — must match app/lib/common/api_config.dart default port.
PORT=3003

# Base URL for portfolio links in API responses (default: http://localhost:{PORT}).
# Use http://YOUR_LAN_IP:3003 for phones on Wi‑Fi, or http://10.0.2.2:3003 for Android emulator browser.
#PUBLIC_BASE_URL=http://localhost:3003

# MongoDB — use Atlas in production. Copy from Atlas → Connect → Drivers (SRV or standard).
# Always include the database name before "?": …/careerpath?…
# Replace USER and PASSWORD; URL-encode special characters in the password (@ # / etc.).
# Paste your full URI from Atlas (include /careerpath before ?). Do not commit real credentials.
MONGODB_URI=

JWT_SECRET=change-this-to-a-long-random-string-in-production

# ATS Rule Engine — must be running under Uvicorn (from repo root):
#   start-ats-uvicorn.cmd   OR   start-all.cmd
# Health check: GET http://127.0.0.1:8000/  -> {"service":"ATS Rule Engine","status":"ok"}
# Upload check: POST http://127.0.0.1:8000/ats-format/check  (multipart field: file)
ATS_FASTAPI_URL=http://127.0.0.1:8000
ATS_FASTAPI_TIMEOUT_MS=20000
# CV Parser (Llama 3.2 + LoRA) — Uvicorn on port 8001 (see ../start-cv-parser-uvicorn.cmd)
# GET  http://127.0.0.1:8001/health
# POST http://127.0.0.1:8001/parse/pdf   (multipart file)
# POST http://127.0.0.1:8001/parse       (JSON resume_text — used for DOCX via Node)
CV_PARSER_URL=http://127.0.0.1:8001
CV_PARSER_TIMEOUT_MS=120000
# When ML parser is off/unavailable, extract PDF/DOCX text and build portfolio JSON
# on the server (used by save-analysis + upload-analyze). Set to 0 to disable.
# CV_TEXT_HEURISTIC=1

# Local mobile: flutter run --dart-define=API_BASE=http://10.0.2.2:3003
# Full local stack: start-local-dev.cmd from repo root (ATS + Parser + Node)
